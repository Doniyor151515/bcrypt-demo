generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Foydalanuvchilar jadvali
// password_plain  — bcrypt O'CHIRILGANDA oddiy parol saqlanadi
// password_hashed — bcrypt YOQILGANDA hash saqlanadi
model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  password_plain  String?  // bcrypt o'chirilganda ishlatiladi
  password_hashed String?  // bcrypt yoqilganda ishlatiladi
  created_at      DateTime @default(now())

  @@map("users")
}
